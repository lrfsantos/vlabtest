    { "id": "vp-g2", "kind": "mc", "difficulty": "intermediate", "prompt": "I want ___ home.", "options": ["to go", "going", "go", "gone"], "answer": "to go", "full": "I want to go home.", "pt": "Quero ir para casa.", "explanation": "want + to + base." },
    { "id": "vp-g3", "kind": "typed", "difficulty": "intermediate", "prompt": "She suggested ___ (leave) early.", "accept": ["leaving"], "answer": "leaving", "full": "She suggested leaving early.", "pt": "Ela sugeriu sair cedo.", "explanation": "suggest + -ing." },
    { "id": "vp-g4", "kind": "mc", "difficulty": "intermediate", "prompt": "He decided ___ home.", "options": ["to stay", "staying", "stay", "stayed"], "answer": "to stay", "full": "He decided to stay home.", "pt": "Ele decidiu ficar em casa.", "explanation": "decide + to + base." },
    { "id": "vp-g5", "kind": "typed", "difficulty": "advanced", "prompt": "I remember ___ (call) you. (lembro de ter)", "accept": ["calling"], "answer": "calling", "full": "I remember calling you.", "pt": "Lembro de ter ligado para você.", "explanation": "remember + -ing = lembrar de ter feito." },
    { "id": "vp-g6", "kind": "mc", "difficulty": "advanced", "prompt": "Remember ___ call me. (lembre-se de)", "options": ["to", "ing", "at", "for"], "answer": "to", "full": "Remember to call me.", "pt": "Lembre-se de me ligar.", "explanation": "remember + to = lembrar de fazer." },
    { "id": "vp-g7", "kind": "mc", "difficulty": "advanced", "prompt": "I stopped ___ to my friend. (parei para falar)", "options": ["to talk", "talking", "talk", "talked"], "answer": "to talk", "full": "I stopped to talk to my friend.", "pt": "Parei para conversar com meu amigo.", "explanation": "stop + to = parar para fazer algo." },
    { "id": "vp-g8", "kind": "typed", "difficulty": "advanced", "prompt": "I stopped ___ (talk). (parei de falar)", "accept": ["talking"], "answer": "talking", "full": "I stopped talking.", "pt": "Parei de falar.", "explanation": "stop + -ing = parar de fazer algo." }
  ],
