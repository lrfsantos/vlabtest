{
  "id": "verb-patterns",
  "name": "Verb patterns",
  "namePt": "Padrões de verbo (-ing / to + base)",
  "group": "related",
  "order": 6,
  "aux": "verb + -ing / verb + to + base",
  "summaryPt": "Qual forma vem depois de cada verbo: -ing ou to + verbo base.",
  "meaningUses": [
    { "pt": "Alguns verbos pedem -ing depois deles", "en": "She enjoys reading. I finished working.", "enPt": "Ela gosta de ler. Terminei de trabalhar." },
    { "pt": "Alguns verbos pedem to + base", "en": "I want to go. She decided to stay.", "enPt": "Quero ir. Ela decidiu ficar." },
    { "pt": "Alguns aceitam os dois, com mudança de sentido", "en": "I stopped to talk. (parei para falar) — I stopped talking. (parei de falar)", "enPt": "Parei para falar. — Parei de falar." }
  ],
  "formation": [
    { "section": "Verbo + -ing", "pt": "enjoy, finish, suggest, mind, avoid, keep + -ing.", "pattern": "enjoy reading — suggest leaving", "examples": [{ "en": "She suggested leaving early.", "pt": "Ela sugeriu sair cedo." }] },
    { "section": "Verbo + to + base", "pt": "want, need, decide, hope, plan, learn + to + base.", "pattern": "want to go — decide to stay", "examples": [{ "en": "I want to learn English.", "pt": "Quero aprender inglês." }] },
    { "section": "Os dois com sentido diferente", "pt": "stop, remember, forget, try.", "pattern": "stop to talk vs stop talking", "examples": [{ "en": "Remember to call me. (lembre-se de) — I remember calling you. (lembro de ter)", "pt": "Lembre-se de me ligar. — Lembro de ter ligado para você." }] }
  ],
  "subjectAgreement": [
    { "pt": "A forma do segundo verbo não muda com a pessoa.", "example": "She wants to go. They want to go. I enjoy reading. He enjoys reading." }
  ],
  "spelling": [],
  "pronunciation": [
    { "pt": "to + verbo: to é fraco → /tə/.", "example": "want to /wɒnt tə/." }
  ],
  "commonErrors": [
    { "pt": "Usar to + base depois de verbos de -ing", "wrong": "She suggested to leave early.", "right": "She suggested leaving early." },
    { "pt": "Usar -ing depois de want/need/decide", "wrong": "I want going home.", "right": "I want to go home." },
    { "pt": "Esquecer o to", "wrong": "I want go home.", "right": "I want to go home." }
  ],
  "contrast": [
    { "with": "modals", "pt": "Modais vêm sem to. Outros verbos pedem to + base.", "en": "I can go. (sem to) — I want to go. (com to)", "enPt": "Eu posso ir. — Eu quero ir." }
  ],
  "examples": [
    { "en": "She enjoys reading.", "pt": "Ela gosta de ler." },
    { "en": "I want to learn English.", "pt": "Quero aprender inglês." },
    { "en": "She suggested leaving early.", "pt": "Ela sugeriu sair cedo." },
    { "en": "I stopped to talk to my friend.", "pt": "Parei para conversar com meu amigo." },
    { "en": "He decided to stay home.", "pt": "Ele decidiu ficar em casa." }
  ],
  "guidedPractice": [
