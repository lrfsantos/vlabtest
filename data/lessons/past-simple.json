    { "id": "past-g6", "kind": "mc", "difficulty": "intermediate", "prompt": "They ___ the bus this morning.", "options": ["missed", "miss", "missing", "misses"], "answer": "missed", "full": "They missed the bus this morning.", "pt": "Eles perderam o ônibus esta manhã.", "explanation": "Regular: miss → missed." },
