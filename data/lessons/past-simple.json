    { "id": "past-r2", "kind": "typed", "difficulty": "basic", "prompt": "She ___ (walk) to school.", "accept": ["walked"], "answer": "walked", "full": "She walked to school.", "pt": "Ela foi a pé para a escola.", "explanation": "Regular: walk → walked." },
