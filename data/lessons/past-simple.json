{
  "id": "past-simple",
  "name": "Past Simple",
  "namePt": "Passado Simples",
  "group": "past",
  "order": 1,
  "aux": "did",
  "summaryPt": "Ação concluída no passado, com tempo definido ou implícito.",
  "meaningUses": [
    { "pt": "Ação concluída com tempo definido", "en": "I visited Rio in 2019.", "enPt": "Visitei o Rio em 2019." },
    { "pt": "Sequência de eventos no passado", "en": "I woke up, ate breakfast, and left.", "enPt": "Acordei, tomei café e saí." },
    { "pt": "Histórias e lembranças", "en": "We had a great time.", "enPt": "Nós nos divertimos muito." }
  ],
  "formation": [
    { "section": "Afirmativa", "pt": "Verbos regulares: verbo + -ed. Irregulares: forma própria (go → went).", "pattern": "I worked — she went", "examples": [{ "en": "She worked late last night.", "pt": "Ela trabalhou até tarde ontem à noite." }] },
    { "section": "Negativa", "pt": "didn't (did not) + verbo base.", "pattern": "I didn't work — she didn't go", "examples": [{ "en": "I didn't watch TV last night.", "pt": "Não assisti TV ontem à noite." }] },
    { "section": "Perguntas", "pt": "Did + sujeito + verbo base?", "pattern": "Did you work? — Did she go?", "examples": [{ "en": "Did you sleep well?", "pt": "Você dormiu bem?" }] },
    { "section": "Respostas curtas", "pt": "Yes, + pronome + did. No, + pronome + didn't.", "pattern": "Yes, I did. / No, she didn't.", "examples": [{ "en": "A: Did you go? B: Yes, I did.", "pt": "A: Você foi? B: Sim." }] }
  ],
  "subjectAgreement": [
    { "pt": "A mesma forma para todas as pessoas.", "example": "I worked. You worked. She worked. We worked. They worked." }
  ],
  "spelling": [
    { "pt": "Verbos regulares: verbo + -ed", "example": "work → worked, play → played" },
    { "pt": "Terminados em -e: só + -d", "example": "live → lived, like → liked" },
    { "pt": "Consoante + y → -ied", "example": "study → studied, try → tried" },
    { "pt": "Consoante-vogal-consoante (curta): dobra a consoante", "example": "stop → stopped, plan → planned" }
  ],
  "pronunciation": [
    { "pt": "O -ed é pronunciado /t/, /d/ ou /ɪd/, conforme o som final.", "example": "worked /t/, played /d/, wanted /ɪd/" },
    { "pt": "/ɪd/ só depois de som de t ou d.", "example": "wanted, needed, started" }
  ],
  "commonErrors": [
    { "pt": "Usar presente em vez de passado com tempo definido", "wrong": "I visit Rio in 2019.", "right": "I visited Rio in 2019." },
    { "pt": "Esquecer o -ed nos regulares", "wrong": "She work late.", "right": "She worked late." },
    { "pt": "Manter o verbo no passado depois do didn't", "wrong": "I didn't worked.", "right": "I didn't work." }
  ],
  "contrast": [
    { "with": "present-perfect", "pt": "Past simple = tempo definido. Present perfect = experiência sem tempo.", "en": "I visited Rio in 2019. — I have visited Rio.", "enPt": "Visitei o Rio em 2019. — Já visitei o Rio." }
  ],
  "examples": [
    { "en": "She worked late last night.", "pt": "Ela trabalhou até tarde ontem à noite." },
    { "en": "We went to the beach on Sunday.", "pt": "Fomos à praia no domingo." },
    { "en": "I didn't watch TV last night.", "pt": "Não assisti TV ontem à noite." },
    { "en": "Did you sleep well?", "pt": "Você dormiu bem?" },
    { "en": "They studied for the test.", "pt": "Eles estudaram para a prova." }
  ],
