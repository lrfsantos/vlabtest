    { "id": "past-g3", "kind": "mc", "difficulty": "basic", "prompt": "I ___ TV last night.", "options": ["didn't watch", "don't watch", "didn't watched", "not watch"], "answer": "didn't watch", "full": "I didn't watch TV last night.", "pt": "Não assisti TV ontem à noite.", "explanation": "Negativa: didn't + verbo base." },
    { "id": "past-g4", "kind": "mc", "difficulty": "intermediate", "prompt": "___ you sleep well?", "options": ["Did", "Do", "Does", "Were"], "answer": "Did", "full": "Did you sleep well?", "pt": "Você dormiu bem?", "explanation": "Pergunta no passado: Did + sujeito + verbo base." },
