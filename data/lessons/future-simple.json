    { "id": "fut-r2", "kind": "typed", "difficulty": "basic", "prompt": "She ___ (call) you tomorrow.", "accept": ["will call"], "answer": "will call", "full": "She will call you tomorrow.", "pt": "Ela vai te ligar amanhã.", "explanation": "will + verbo base." },
    { "id": "fut-r3", "kind": "mc", "difficulty": "basic", "prompt": "I ___ be late.", "options": ["won't", "isn't", "didn't", "doesn't"], "answer": "won't", "full": "I won't be late.", "pt": "Não vou me atrasar.", "explanation": "Negativa: won't + verbo base." },
    { "id": "fut-r4", "kind": "mc", "difficulty": "intermediate", "prompt": "___ they come to dinner?", "options": ["Will", "Do", "Are", "Did"], "answer": "Will", "full": "Will they come to dinner?", "pt": "Eles vão vir para o jantar?", "explanation": "Pergunta: Will + sujeito + verbo base." },
    { "id": "fut-r5", "kind": "typed", "difficulty": "intermediate", "prompt": "I'm sure she ___ (pass) the test.", "accept": ["will pass"], "answer": "will pass", "full": "I'm sure she will pass the test.", "pt": "Tenho certeza que ela vai passar na prova.", "explanation": "Previsão → will + verbo base." },
