    { "id": "fut-g2", "kind": "mc", "difficulty": "basic", "prompt": "She ___ come to the party.", "options": ["won't", "isn't", "didn't", "doesn't"], "answer": "won't", "full": "She won't come to the party.", "pt": "Ela não vai vir à festa.", "explanation": "Negativa: will not → won't + verbo base." },
    { "id": "fut-g3", "kind": "typed", "difficulty": "basic", "prompt": "It ___ (rain) tomorrow.", "accept": ["will rain"], "answer": "will rain", "full": "It will rain tomorrow.", "pt": "Vai chover amanhã.", "explanation": "Previsão → will + verbo base." },
    { "id": "fut-g4", "kind": "mc", "difficulty": "intermediate", "prompt": "___ you help me?", "options": ["Will", "Do", "Are", "Did"], "answer": "Will", "full": "Will you help me?", "pt": "Você vai me ajudar?", "explanation": "Pergunta: Will + sujeito + verbo base." },
    { "id": "fut-g5", "kind": "mc", "difficulty": "intermediate", "prompt": "I ___ be late. I promise.", "options": ["won't", "will", "am not", "didn't"], "answer": "won't", "full": "I won't be late. I promise.", "pt": "Não vou me atrasar. Prometo.", "explanation": "Promessa → won't + verbo base." },
    { "id": "fut-g6", "kind": "typed", "difficulty": "intermediate", "prompt": "Don't worry, I ___ (help) you.", "accept": ["will help"], "answer": "will help", "full": "Don't worry, I'll help you.", "pt": "Não se preocupe, vou te ajudar.", "explanation": "Oferta espontânea → will + verbo base." },
