    { "id": "fut-r8", "kind": "typed", "difficulty": "advanced", "prompt": "I'll ___ (meet) you at the station.", "accept": ["meet"], "answer": "meet", "full": "I'll meet you at the station.", "pt": "Vou te encontrar na estação.", "explanation": "will + verbo base (sem to)." },
    { "id": "fut-r9", "kind": "mc", "difficulty": "advanced", "prompt": "Don't worry, ___ take care of it.", "options": ["I'll", "I'm", "I did", "I have"], "answer": "I'll", "full": "Don't worry, I'll take care of it.", "pt": "Não se preocupe, vou cuidar disso.", "explanation": "Oferta espontânea → will ('ll)." },
