{
  "id": "future-simple",
  "name": "Future Simple (will)",
  "namePt": "Futuro Simples (will)",
  "group": "future",
  "order": 1,
  "aux": "will",
  "summaryPt": "Decisões espontâneas, previsões e promessas.",
  "meaningUses": [
    { "pt": "Decisão espontânea na hora de falar", "en": "I'll help you.", "enPt": "Eu vou te ajudar." },
    { "pt": "Previsão (com ou sem evidência)", "en": "It will rain tomorrow.", "enPt": "Vai chover amanhã." },
    { "pt": "Promessa ou oferta", "en": "I'll call you later.", "enPt": "Vou te ligar mais tarde." }
  ],
  "formation": [
    { "section": "Afirmativa", "pt": "Sujeito + will + verbo base.", "pattern": "I will go — she will go", "examples": [{ "en": "I'll call you later.", "pt": "Vou te ligar mais tarde." }] },
    { "section": "Negativa", "pt": "Sujeito + won't (will not) + verbo base.", "pattern": "I won't go", "examples": [{ "en": "I won't be late.", "pt": "Não vou me atrasar." }] },
    { "section": "Perguntas", "pt": "Will + sujeito + verbo base?", "pattern": "Will you come?", "examples": [{ "en": "Will you help me?", "pt": "Você vai me ajudar?" }] },
    { "section": "Respostas curtas", "pt": "Yes, + pronome + will. No, + pronome + won't.", "pattern": "Yes, I will. / No, I won't.", "examples": [{ "en": "A: Will you come? B: Yes, I will.", "pt": "A: Você vai vir? B: Sim." }] }
  ],
  "subjectAgreement": [
    { "pt": "A mesma forma (will) para todas as pessoas.", "example": "I will go. She will go. They will go." }
  ],
  "spelling": [],
  "pronunciation": [
    { "pt": "will é geralmente contraído para 'll na fala.", "example": "I'll, she'll, they'll" },
    { "pt": "won't rima com don't.", "example": "won't /woʊnt/" }
  ],
  "commonErrors": [
    { "pt": "Usar will + forma do passado", "wrong": "I will went.", "right": "I will go." },
    { "pt": "Usar 'will' para planos já combinados (melhor: be going to ou presente contínuo)", "wrong": "I will meet her at 6. (decidido antes)", "right": "I'm meeting her at 6. (plano combinado)" }
  ],
  "contrast": [
    { "with": "going-to", "pt": "will = decisão espontânea/previsão. be going to = plano já decidido.", "en": "It's raining. I'll take an umbrella. (espontâneo) — I'm going to visit my mom. (plano)", "enPt": "Está chovendo. Vou levar um guarda-chuva. — Vou visitar minha mãe." }
  ],
  "examples": [
    { "en": "I'll call you later.", "pt": "Vou te ligar mais tarde." },
    { "en": "It will rain tomorrow.", "pt": "Vai chover amanhã." },
    { "en": "I won't be late.", "pt": "Não vou me atrasar." },
    { "en": "Will you help me?", "pt": "Você vai me ajudar?" },
    { "en": "Don't worry. I'll help you.", "pt": "Não se preocupe. Eu vou te ajudar." }
  ],
  "guidedPractice": [
