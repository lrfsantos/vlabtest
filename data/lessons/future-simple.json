    { "id": "fut-g8", "kind": "mc", "difficulty": "advanced", "prompt": "I think it ___ rain tonight.", "options": ["will", "is", "does", "did"], "answer": "will", "full": "I think it will rain tonight.", "pt": "Acho que vai chover hoje à noite.", "explanation": "Previsão → will + verbo base." }
  ],
